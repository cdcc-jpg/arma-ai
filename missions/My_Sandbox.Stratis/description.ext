author = "Arma-AI Systems Engineering Team";
onLoadName = "AAI Grounding Sandbox";
onLoadMission = "Autonomous spatial grounding engine, ballistic cover shadow evaluation, and 3D affordance visualizer.";
briefingName = "AAI - Tactical Grounding & Affordance Sandbox (VR)";
overviewText = "Testbed for real-time 3D perception, boundingBoxReal spatial grounding, ballistic shadow cones, and stance affordance controllers.";

// Mission Settings
enableDebugConsole = 2;
saving = 0;
respawn = 3;
respawnDelay = 3;
respawnDialog = 0;
respawnOnStart = -1;

class Header {
    gameType = Sandbox;
    minPlayers = 1;
    maxPlayers = 4;
};

// =============================================================================
// CfgFunctions Registration
// =============================================================================
class CfgFunctions {
    class AAI {
        tag = "AAI";

        class Grounding {
            file = "src\grounding";
            class perceiveObstacles {};
            class computeCoverShadow {};
            class evaluateStanceAffordance {};
            class computeCornerSlices {};
        };

        class Controller {
            file = "src\controller";
            class tacticalTick {};
            class executeMovement {};
            class startAgentController {};
            class updateKnowledgeGraph {};
        };

        class Debug {
            file = "src\debug";
            class drawTacticalOverlay {};
        };
    };
};
