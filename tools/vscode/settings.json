{
    "files.associations": {
        "*.sqf": "sqf",
        "*.ext": "sqf",
        "*.sqm": "cpp",
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.ttl": "turtle",
        "*.trig": "turtle",
        "*.sparql": "sparql"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/.hemttout": false
    },
    "search.exclude": {
        "**/.hemttout": true,
        "**/*.pbo": true
    },
    "[sqf]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[toml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    }
}
